# Supabase — hoje é o MESMO projeto do sistema de gestão interno
# (Eksteel_system), por decisão explícita: enquanto só dono+sócio usam os
# dois sistemas, não compensa manter dois projetos Supabase separados. O
# modelador em si não guarda nada nesse banco (só Auth) — os projetos
# continuam salvos localmente (pasta escolhida pelo usuário).
#
# ATENÇÃO — isso precisa mudar antes de vender licença: quando o modelador
# passar a ter clientes pagantes, a base de usuários dele não pode mais
# compartilhar o mesmo projeto/base do sistema de gestão (que deve
# continuar só pra dono+sócio pra sempre). Nesse momento, trocar pra um
# projeto Supabase separado (ex.: o do Eksteel-site, o site principal) —
# usar as mesmas credenciais do Eksteel_system/.env.local é só uma decisão
# temporária de fase, não definitiva.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role do MESMO projeto acima — nunca leva o prefixo
# NEXT_PUBLIC_ (fica só no servidor, nunca é enviada ao navegador). Usada
# só pela rota /api/auth/check-email pra conferir se um e-mail já tem conta
# antes de tentar logar. Painel do Supabase → Project Settings → API →
# service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Deixe em branco — cookie de sessão compartilhado entre modelador e
# gestão NÃO foi pedido (só o projeto Supabase é compartilhado, não a
# sessão): logar num continua exigindo logar no outro separadamente. Só
# preencher aqui (ex.: .eksteelsolucoes.com.br) se um dia quiser SSO de
# verdade entre os dois, o que é uma decisão à parte desta.
NEXT_PUBLIC_COOKIE_DOMAIN=
