# Supabase do software: Settings > API. Use somente a chave pública anon
# (ou publishable). Nunca coloque service_role/secret em NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA
# Opcional, somente se houver autenticação compartilhada entre subdomínios:
# NEXT_PUBLIC_COOKIE_DOMAIN=.exemplo.com.br

# Conectores SQL: destinos exatos autorizados pelo administrador (não usar NEXT_PUBLIC).
# Sem esta configuração, nenhuma conexão SQL externa é permitida.
# CAD_DATABASE_ALLOWED_HOSTS=db.cliente.com:5432,mysql.cliente.com:3306,sql.cliente.com:1433
# Opcional: certificado CA PEM para bancos com autoridade privada. TLS sempre validado.
# CAD_DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Configuração inicial pela interface em produção (segredo gerado pelo operador).
# CAD_SETUP_TOKEN=use-um-token-aleatorio-com-pelo-menos-24-caracteres
# Diretório persistente/gravável para configuração via interface:
# CAD_CONFIG_DIR=/caminho/volume/config

# Simulação: serviço privado Gmsh + CalculiX (ver docs/SIMULATION.md).
# Mesma chave no serviço Python. Nunca usar prefixo NEXT_PUBLIC_.
# FEA_SERVICE_URL=http://127.0.0.1:8090
# FEA_API_TOKEN=gere-um-segredo-aleatorio-com-24-ou-mais-caracteres

# Downloads públicos do comunicador completo (HTTPS, sem credenciais ou query string).
# Configure somente após publicar e validar o pacote de cada sistema.
# FEA_COMMUNICATOR_WINDOWS_URL=https://downloads.exemplo.com/EksteelComunicador-Setup.exe
# FEA_COMMUNICATOR_LINUX_URL=https://downloads.exemplo.com/eksteel-comunicador_VERSAO_amd64.deb

# Autenticação isolada da emeka_system (novo projeto; não reutiliza o banco CAD).
EMEKA_SUPABASE_URL=
EMEKA_SUPABASE_ANON_KEY=
# EMEKA_CONFIG_DIR=/caminho/volume/emeka-config
# Somente para scripts/setup-emeka.cjs; conexão administrativa privada do NOVO projeto.
# EMEKA_DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Certificado CA baixado do painel do novo Supabase (somente servidor).
# EMEKA_DATABASE_CA_FILE=./prod-ca-2021.crt
